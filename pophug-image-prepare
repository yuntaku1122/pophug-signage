#!/bin/bash
# ============================================
# pophug-image-prepare
#
# 量産用の「マスターイメージ」を作る直前に、お手本となる1台のPi上で
# 一度だけ実行するスクリプト。
#
# ここでは「起動前に済ませておかないと、複製先が自分では気づけない」
# 項目（ホスト名・SSH鍵・machine-id）だけをリセットする。
# Wi-Fi接続情報・images/フォルダの中身・過去のアップデートのバックアップは、
# ホスト名が初期値のままだと自動的に消去される仕組みが pophug-hostname-setup
# 側に既にあるため、ここで重ねて消す必要はない（複製先が初回起動時に自分で行う）。
#
# 実行後は速やかに電源を切り、SDカードを取り出してイメージ化すること。
# このPi自体を、実行後もそのまま使い続けることは想定していない
# （次に起動した時点で、複製先の1台目として扱われてしまうため）。
#
# 使い方:
#   bash pophug-image-prepare
# ============================================

set -e

echo "=== pophug 量産マスターイメージ準備スクリプト ==="
echo "このPi自体は、実行後すぐに電源を切ってイメージ化する前提です。"
echo "（実行後にこのPiを普段使いに戻すことは想定していません）"
echo "Wi-Fi接続情報・写真・アップデートのバックアップは、次回起動時に"
echo "pophug-hostname-setupが自動で消去するため、ここでは扱いません。"
echo ""
read -p "続行しますか？ (yes と入力): " CONFIRM
if [ "$CONFIRM" != "yes" ]; then
    echo "中止しました"
    exit 1
fi

echo ""
echo "--- ホスト名を工場出荷時の状態(pophug)に戻す ---"
sudo hostnamectl set-hostname pophug
sudo sed -i "s/^127\.0\.1\.1.*/127.0.1.1\tpophug/" /etc/hosts

echo "--- SSHホスト鍵を削除（次回起動時にpophug-hostname-setupが自動再生成） ---"
sudo rm -f /etc/ssh/ssh_host_*

echo "--- machine-id を消去（次回起動時にsystemdが自動再生成） ---"
sudo truncate -s 0 /etc/machine-id
sudo rm -f /var/lib/dbus/machine-id
sudo ln -sf /etc/machine-id /var/lib/dbus/machine-id

echo "--- コマンド履歴・ログを消去 ---"
cat /dev/null > "$HOME/.bash_history" 2>/dev/null || true
history -c 2>/dev/null || true
sudo journalctl --rotate 2>/dev/null || true
sudo journalctl --vacuum-time=1s 2>/dev/null || true

echo ""
echo "--- イメージファイルを小さくするためのクリーンアップ ---"
echo "  apt/pipのキャッシュを削除..."
sudo apt-get clean
rm -rf "$HOME/.cache/pip"

echo "  Pythonの__pycache__を削除..."
find "$HOME/pophug-signage" -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true

echo "  /tmp を掃除..."
sudo find /tmp -mindepth 1 -delete 2>/dev/null || true

echo "  未使用領域をゼロ埋め（この後Mac側で圧縮する際に効果が大きくなります。"
echo "  ディスクの空き容量によっては数分かかります）..."
# 完全に埋め切ると(ENOSPCになると)、SSH接続自体が道連れで切れることがあるため、
# 安全マージンを残して手前で止める
ZEROFILL_SAFETY_MARGIN_MB=200
FREE_MB=$(df --output=avail -m / | tail -1 | tr -d ' ')
FILL_MB=$((FREE_MB - ZEROFILL_SAFETY_MARGIN_MB))
if [ "$FILL_MB" -gt 0 ]; then
    sudo dd if=/dev/zero of=/zerofill bs=1M count="$FILL_MB" 2>/dev/null || true
else
    echo "  空き容量が少ないためゼロ埋めをスキップしました"
fi
sudo rm -f /zerofill
sync

echo ""
echo "=== 完了しました ==="
echo "このまま以下を実行してPiの電源を切り、SDカードを取り出してイメージ化してください。"
echo ""
echo "  sudo shutdown -h now"
echo ""
echo "Mac側でのイメージ化手順（Piの電源を切った後、SDカードを挿した状態で）:"
echo ""
echo "  【推奨】ApplePi-Baker（無料・Mac用GUIアプリ）を使うと、使用領域まで自動で"
echo "  縮小しながらバックアップできるため、ddで生成する場合よりファイルがかなり"
echo "  小さくなります。「Backup」で対象ディスクを選び、「Shrink」にチェックを"
echo "  入れて実行してください（.imgまたは.img.gz等で保存可）。"
echo "  https://www.tweaking4all.com/software/macosx-software/applepi-baker-v2/"
echo "  ※ macOSのバージョンによってはShrinkが正しく動かない報告もあるため、"
echo "  一度小さいSDカードに書き戻して起動確認することをお勧めします。"
echo ""
echo "  【代替】上記が使えない場合は、従来通りddで生成してから手元でgzip圧縮"
echo "  してください（パーティション自体は縮小されないため、元のSDカードと"
echo "  同じ容量以上のカードにしか書き込めない点に注意）:"
echo "    diskutil list                                    # SDカードのディスク番号を確認"
echo "    sudo dd if=/dev/rdiskN of=~/pophug-master.img bs=4m status=progress"
echo "    gzip ~/pophug-master.img                          # -> pophug-master.img.gz"
echo ""
echo "以降は Raspberry Pi Imager で作成したイメージ（.imgまたは.img.gz等の圧縮形式も"
echo "そのまま選べます）を選んで書き込むだけで、新しい1台をセットアップできます"
echo "（git clone・pip install等は不要）。"
echo "初回起動時に、Wi-Fi接続情報・写真・アップデートのバックアップも"
echo "自動的に消去された上で、機体ごとに一意なホスト名が設定されます。"

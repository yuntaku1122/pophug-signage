#!/usr/bin/env python3
# ============================================
# pophug-update-apply
#
# アップデート処理のうち、root権限が必要な最後の仕上げだけを行う
# 限定ヘルパースクリプト。
#   0. staging_dir/pophug-update-apply があれば、自分自身(/usr/local/bin/pophug-update-apply)
#      を置き換える（このスクリプト自体の将来の変更を、次回のアップデートから
#      自動的に反映できるようにするため）
#   1. staging_dir/pophug-netctl があれば /usr/local/bin/pophug-netctl を置き換える
#   2. staging_dir/pophug-hostname-setup があれば /usr/local/bin/pophug-hostname-setup を置き換える
#   3. staging_dir/pophug-hostname-setup.service があれば
#      /etc/systemd/system/pophug-hostname-setup.service を置き換え、daemon-reloadする
#   4. staging_dir/pophug-signage.service があれば
#      /etc/systemd/system/pophug-signage.service を置き換え、daemon-reloadする
#      （Type=notify・WatchdogSec等、本体サービスの起動方法自体の設定もここで配信できるようにする）
#   5. staging_dir/pophug-usb-import があれば /usr/local/bin/pophug-usb-import を置き換える
#   6. staging_dir/pophug-usb-import@.service があれば
#      /etc/systemd/system/pophug-usb-import@.service を置き換え、daemon-reloadする
#   7. staging_dir/99-pophug-usb.rules があれば /etc/udev/rules.d/99-pophug-usb.rules を
#      置き換え、udevadm control --reload-rules する
#   8. exfatprogsが未インストールなら、インストールをバックグラウンドで予約する
#      （apt-get updateは数十秒かかることがあり、このスクリプト自体をブロックすると
#      呼び出し元のタイムアウトでアップデート処理自体が失敗扱いになってしまうため、
#      systemd-runで完全に切り離して非同期実行する。5〜8はUSB取り込み機能一式で、
#      これにより新しいバージョンをOTA適用するだけで自動的にインストールされるように
#      なる。以前は手順書のコマンドを毎回手動実行してもらう必要があった）
#   9. pophug-signage.service を再起動する
#
# ファイルの展開・入れ替え・バックアップなど、それ以外の処理は
# 全て非特権側(update_check.py)で行い、ここでは行わない。
#
# インストール:
#   sudo cp scripts/pophug-update-apply /usr/local/bin/
#   sudo chmod 755 /usr/local/bin/pophug-update-apply
#   sudo chown root:root /usr/local/bin/pophug-update-apply
# ============================================

import filecmp
import os
import shutil
import subprocess
import sys
import time

UPDATE_APPLY_DEST = "/usr/local/bin/pophug-update-apply"
NETCTL_DEST = "/usr/local/bin/pophug-netctl"
HOSTNAME_SETUP_DEST = "/usr/local/bin/pophug-hostname-setup"
HOSTNAME_SERVICE_DEST = "/etc/systemd/system/pophug-hostname-setup.service"
SIGNAGE_SERVICE_DEST = "/etc/systemd/system/pophug-signage.service"
USB_IMPORT_DEST = "/usr/local/bin/pophug-usb-import"
USB_IMPORT_SERVICE_DEST = "/etc/systemd/system/pophug-usb-import@.service"
USB_UDEV_RULES_DEST = "/etc/udev/rules.d/99-pophug-usb.rules"


def _install_helper(staging_dir, filename, dest_path, mode=0o755):
    """staging_dir内に該当ファイルがあり、かつ配置先と内容が異なる場合のみ
    コピーする（存在するだけでは何もしない）。staging_dirはpophug-signageの
    常設リポジトリそのもの（APP_DIR）であり、対象ファイルは変更の有無に関わらず
    「毎回必ず存在」するため、存在チェックだけで「更新した」とみなすと、
    実際には内容が同じでも毎回コピー・自己再実行が発生してしまう
    （pophug-update-apply自身の自己更新チェックでこれが無限ループを引き起こした
    実績があるため、内容比較を必須にしている）。"""
    src = os.path.join(staging_dir, filename)
    if not os.path.isfile(src):
        return False
    if os.path.isfile(dest_path) and filecmp.cmp(src, dest_path, shallow=False):
        return False  # 内容が同一＝変更なし
    shutil.copy(src, dest_path)
    os.chmod(dest_path, mode)
    shutil.chown(dest_path, user="root", group="root")
    return True


def _content_differs(src, dest_path):
    """destが存在しない、または内容がsrcと異なるか（＝コピー・再読み込みが
    本当に必要か）を返す。ユニットファイル・udevルールの不要な毎回コピーと
    daemon-reload/udevadm再読み込みの連発を避けるために使う。"""
    if not os.path.isfile(dest_path):
        return True
    return not filecmp.cmp(src, dest_path, shallow=False)


def _schedule_exfatprogs_install():
    """exFAT対応パッケージ(exfatprogs)が未インストールなら、バックグラウンドで
    インストールを予約する。既にインストール済みなら何もしない（dpkg -sは
    即座に返るため、通常のアップデートのたびに余計な処理は発生しない）。
    apt-get updateは数十秒かかることがあり、このスクリプト自体（呼び出し元の
    update_check.pyから短いタイムアウト付きで呼ばれる）をここでブロックすると
    アップデート処理自体が失敗扱いになってしまうため、再起動予約と同じく
    systemd-runで完全に切り離して非同期実行する。"""
    check = subprocess.run(["dpkg", "-s", "exfatprogs"], capture_output=True)
    if check.returncode == 0:
        return
    unit_name = f"pophug-exfatprogs-install-{int(time.time())}"
    r = subprocess.run([
        "systemd-run", "--collect", "--on-active=1",
        f"--unit={unit_name}",
        "/bin/sh", "-c",
        "apt-get update && apt-get install -y exfatprogs",
    ])
    if r.returncode == 0:
        print(f"exfatprogsのインストールをバックグラウンドで予約しました（{unit_name}）")
    else:
        print("exfatprogsのインストール予約に失敗しました（後で手動インストールしてください）")


def _reexec_self(staging_dir):
    """自己更新した直後に呼ぶ。今のプロセスを、たった今書き込んだ新しい
    pophug-update-applyでそのまま置き換える（os.execvはプロセスを別プログラムの
    実行に置き換える。成功時はこの関数から戻ってこない）。"""
    os.execv(UPDATE_APPLY_DEST, [UPDATE_APPLY_DEST, staging_dir])


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: pophug-update-apply <staging_dir>")

    staging_dir = sys.argv[1]
    if not os.path.isdir(staging_dir):
        sys.exit(f"staging dir not found: {staging_dir}")

    # このスクリプト自身を最初に自己更新する。実行中のプロセスはメモリ上に読み込み
    # 済みのファイル実体を使い続けるためこの場で上書きしても安全（Linuxのinodeの性質上、
    # 実行中に自分自身のファイル内容を書き換えても今の実行には影響しない）。
    #
    # ただし、自己更新した回だけは要注意で、「今動いているのは書き換え前の古い
    # ロジックのまま」なので、このバージョンでpophug-update-apply自体に追加された
    # 新しい配置ロジック（今回で言えばUSB機能一式のインストール）は、このまま
    # 続行しても実行されない。これを補うため、自己更新できた場合は残りの処理を
    # 続けず、たった今書き込んだ新しいファイルへos.execvでそのまま処理を
    # 引き継ぐ。こうすることで、pophug-update-apply自体に変更が入るような
    # バージョンへのアップデートも、SSHでの手動実行を挟まず、Web画面からの
    # アップデート1回だけで完全に反映できる（execvは今のプロセスを新しい
    # プログラムに置き換えるだけなので、再起動の予約が二重にされることもない。
    # 新しいプロセスが最後に1回だけ予約する）。
    if _install_helper(staging_dir, "pophug-update-apply", UPDATE_APPLY_DEST):
        print("pophug-update-apply (self) updated")
        try:
            print("新しいバージョンのpophug-update-applyに処理を引き継ぎます...")
            _reexec_self(staging_dir)
        except OSError as e:
            # 通常はここに到達しない（execvが成功すればプロセスごと置き換わるため）。
            # 万一失敗した場合も、アップデート処理自体は失敗させず、今のロジックで続行する
            print(f"新しいバージョンへの引き継ぎに失敗しました（今回はこのまま続行します）: {e}")

    if _install_helper(staging_dir, "pophug-netctl", NETCTL_DEST):
        print("pophug-netctl updated")

    if _install_helper(staging_dir, "pophug-hostname-setup", HOSTNAME_SETUP_DEST):
        print("pophug-hostname-setup updated")

    if _install_helper(staging_dir, "pophug-usb-import", USB_IMPORT_DEST):
        print("pophug-usb-import updated")

    unit_changed = False

    hostname_service_src = os.path.join(staging_dir, "pophug-hostname-setup.service")
    if os.path.isfile(hostname_service_src) and _content_differs(hostname_service_src, HOSTNAME_SERVICE_DEST):
        shutil.copy(hostname_service_src, HOSTNAME_SERVICE_DEST)
        unit_changed = True
        print("pophug-hostname-setup.service updated")

    signage_service_src = os.path.join(staging_dir, "pophug-signage.service")
    if os.path.isfile(signage_service_src) and _content_differs(signage_service_src, SIGNAGE_SERVICE_DEST):
        shutil.copy(signage_service_src, SIGNAGE_SERVICE_DEST)
        unit_changed = True
        print("pophug-signage.service updated")

    usb_service_src = os.path.join(staging_dir, "pophug-usb-import@.service")
    if os.path.isfile(usb_service_src) and _content_differs(usb_service_src, USB_IMPORT_SERVICE_DEST):
        shutil.copy(usb_service_src, USB_IMPORT_SERVICE_DEST)
        unit_changed = True
        print("pophug-usb-import@.service updated")

    if unit_changed:
        subprocess.run(["systemctl", "daemon-reload"])
        print("daemon-reload done")

    udev_rules_src = os.path.join(staging_dir, "99-pophug-usb.rules")
    if os.path.isfile(udev_rules_src) and _content_differs(udev_rules_src, USB_UDEV_RULES_DEST):
        shutil.copy(udev_rules_src, USB_UDEV_RULES_DEST)
        subprocess.run(["udevadm", "control", "--reload-rules"])
        print("99-pophug-usb.rules updated, udev rules reloaded")

    _schedule_exfatprogs_install()

    # このスクリプト自身も元をたどれば pophug-signage.service から呼ばれた
    # 子プロセスなので、同じプロセスグループに属している。
    # 素の"systemctl restart"（結果を待つ）はもちろん、"--no-block"（予約だけしてすぐ戻る）
    # でも、予約後ほぼ即座に実際の再起動処理が始まってしまうため、このスクリプト自身が
    # 正常終了して制御を戻すタイミングと僅かに競合し、稀に巻き込まれて強制終了する
    # 不具合が実際に発生した。
    # そこで、再起動処理そのものを「2秒後に発火する、今の処理系統とは完全に独立した
    # 一時的なタイマーユニット」として systemd-run で予約する。これにより、
    # 今の処理系統が全て正常に完了し、Web側に結果を返し終えるまでの
    # 十分な猶予（2秒）を確保してから実際の再起動が始まるようにする。
    unit_name = f"pophug-restart-{int(time.time())}"
    r = subprocess.run([
        "systemd-run", "--collect", "--on-active=2",
        f"--unit={unit_name}",
        "systemctl", "restart", "pophug-signage.service",
    ])
    if r.returncode != 0:
        sys.exit("failed to schedule service restart")
    print(f"service restart scheduled via {unit_name} (in 2s)")


if __name__ == "__main__":
    main()

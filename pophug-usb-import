#!/usr/bin/env python3
# ============================================
# pophug-usb-import
#
# USBメモリー挿入時に自動実行される、root権限が必要な画像取り込み・
# アップデートパッケージ検出・設定ファイル適用処理。udevルール
# (99-pophug-usb.rules)経由で、systemdテンプレートユニット
# (pophug-usb-import@.service)としてroot権限で起動される。
# ネットワーク経由の入力は一切受け付けず、起動元はカーネルの
# udevイベントのみ（pophug-netctl等のようにWebサーバーからsudo経由で
# 呼ばれるものではない）。
#
# 処理の流れ（画像取り込み）:
#   1. 対象パーティションを読み取り専用でマウント（USB側は一切変更しない）
#   2. トップレベル（サブフォルダは対象外）の画像ファイルだけを走査
#      （ドットファイル・拡張子と中身が一致しないファイルは除外。macOSでUSBメモリーを
#      扱うと自動生成される ._写真.jpg のようなAppleDouble付随ファイルが、
#      本物の画像として誤って取り込まれてしまうのを防ぐため）
#   3. 内容のハッシュ値で重複チェックし、未取込のものだけ
#      images/usb_YYYYMMDD_HHMMSS_連番.拡張子 としてコピー
#   4. ファイル名が「fixed_」で始まるものは「固定表示」として登録
#      （images/.pinned.json。優先表示等と同じくWeb設定画面からも切替可能）
#   5. 今回取り込んだ画像・固定表示画像 以外の既存画像を一括で非表示化
#      （＝USB取り込み後は、そのUSBの内容＋固定表示画像だけが表示される）
#
# 処理の流れ（USBオフラインアップデート、画像取り込みとは独立して毎回行う）:
#   a. トップレベルのzipファイルの中から、pophug-signageのアップデート
#      パッケージ（GitHub Releaseの「Source code (zip)」をそのまま置いたもの。
#      リネーム不要）らしきものを探す（version.py/main.py/signage_state.pyが
#      単一のトップフォルダに揃っているかで判定）
#   b. 現在実行中のバージョンより新しければ、images/.usb_update/pending.zip
#      へコピーし、images/.usb_update_pending.json に検出結果を記録する
#      （実際の適用はまだ行わない。安全のため自動適用はせず、本体ボタンの
#      長押しで明示的に確定してもらう2段階方式。main.py側で処理される）
#
# 処理の流れ（USB設定ファイル、画像取り込みとは独立して毎回行う）:
#   ア. トップレベルに「pophug-settings.txt」(大文字小文字不問)があれば、
#      「key = value」形式（'#'以降はコメント）として解析する
#   イ. 有効な項目だけをimages/.settings.jsonへ即座に自動適用する
#      （画像取り込みと同様、確認なしで反映。設定はコード実行を伴わず
#      いつでもWeb画面から元に戻せる可逆的な操作のため）。範囲外の値や
#      未知のキーは個別にスキップし、ログに警告を残す（1箇所のタイプミスで
#      ファイル全体が無視されることはない）
#
#   共通の後処理:
#   6. 本体画面に完了通知（images/.notice.json、USBを抜くまで表示され続ける）を出し、
#      アンマウント
#   7. USBメモリーが抜かれたら（udevのremoveイベント）、表示中の通知を消す
#      （※アップデート確定待ちのバッジ表示は通知とは別の独立した仕組みのため、
#      USBを抜いても消えない＝USBを抜いた後でもボタン長押しで確定できる）
#
# 使い方:
#   pophug-usb-import <デバイス名-add 例: sda1-add>    …挿入時
#   pophug-usb-import <デバイス名-remove 例: sda1-remove> …取り外し時
#   pophug-usb-import <デバイス名>                      …後方互換（-add扱い）
#
# インストール:
#   sudo cp pophug-usb-import /usr/local/bin/
#   sudo chmod 755 /usr/local/bin/pophug-usb-import
#   sudo chown root:root /usr/local/bin/pophug-usb-import
#   sudo cp pophug-usb-import@.service /etc/systemd/system/
#   sudo cp 99-pophug-usb.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo systemctl daemon-reload
#   sudo apt-get install -y exfatprogs   # exFAT対応に必要（FAT32のみなら不要）
# ============================================

import fcntl
import hashlib
import os
import re
import shutil
import subprocess
import sys
import time
import zipfile

# main.py・upload_server.pyと同じ画像フォルダ（pophug-signage.serviceの
# WorkingDirectoryを基準とした ./images と同一パスになるよう固定で指定する。
# このスクリプトはリポジトリ外(/usr/local/bin)に配置されるため相対パスに
# できない）。ユーザー名やインストール先を変えた場合はここも合わせて変更すること。
REPO_DIR = "/home/pophug/pophug-signage"
IMAGE_FOLDER = os.path.join(REPO_DIR, "images")

MOUNT_POINT = "/media/pophug-usb"
POPHUG_USER = "pophug"
POPHUG_GROUP = "pophug"
FIXED_PREFIX = "fixed_"
SUPPORTED_EXT = (".jpg", ".jpeg", ".png")
DEVICE_RE = re.compile(r"^sd[a-z][0-9]+$")
SETTINGS_FILENAME = "pophug-settings.txt"
LOCK_PATH = "/tmp/pophug-usb-import.lock"

# 拡張子ごとの正しいマジックバイト（ファイル先頭の署名）。
# macOSのAppleDouble付随ファイル(._*)等、拡張子だけ画像に見えて中身が
# 画像ではないファイルを弾くための最終チェックに使う。
MAGIC_BYTES = {
    ".jpg": (b"\xff\xd8\xff",),
    ".jpeg": (b"\xff\xd8\xff",),
    ".png": (b"\x89PNG\r\n\x1a\n",),
}

# signage_state.py（標準ライブラリのみに依存）をアプリ本体のディレクトリから
# 直接importする。atomic書き込みや各状態ファイルの読み書きロジックを
# ここで再実装せず、既存の唯一の実装をそのまま再利用するため。
sys.path.insert(0, REPO_DIR)
try:
    import signage_state
except ImportError:
    signage_state = None  # インストール直後などrepo未配置の場合は後段でエラー終了する

# update_check.py（標準ライブラリのみに依存、importするだけではネットワークにも
# アクセスしない）から、バージョン文字列の比較ロジック(_parse_version)と
# 現在のバージョン(__version__)を再利用する。USBアップデートパッケージの
# バージョン判定を、オンラインOTAと同じ基準で行うため。
try:
    import update_check
except ImportError:
    update_check = None  # 未配置の場合はUSBアップデート検出機能だけ無効化する


STATE_FILENAMES = (
    ".hidden.json", ".pinned.json", ".priority.json",
    ".settings.json", ".notice.json", ".usb_imported.json",
    ".usb_update_pending.json",
)

UPDATE_ZIP_REQUIRED_FILES = ("version.py", "main.py", "signage_state.py")


def log(message):
    print(f"[usb-import] {message}", flush=True)


def run(cmd, timeout=30):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        class _R:
            returncode = 1
            stdout = ""
            stderr = "timeout"
        return _R()


def fix_ownership(image_folder):
    """root権限で書き込んだ状態ファイル・画像ファイルの所有者を、
    通常運用時にFlask(pophug-signage.service)を動かしているpophugユーザーへ
    戻す。tempfile.mkstemp()はデフォルトでmode 0600・作成者(root)所有の
    ファイルを作るため、これを戻さないと以後pophugユーザーが読み書きできず
    アプリ全体が壊れてしまう。存在しないファイルはスキップする。
    pophugユーザーが存在しない/権限が無い環境（開発機でのテスト等）でも
    処理全体を止めないよう、失敗はログに残すだけで継続する。"""
    targets = [os.path.join(image_folder, name) for name in STATE_FILENAMES]
    try:
        if os.path.isdir(image_folder):
            targets += [
                os.path.join(image_folder, f) for f in os.listdir(image_folder)
                if os.path.splitext(f)[1].lower() in SUPPORTED_EXT
            ]
    except OSError:
        pass

    # USBアップデートのステージング先(images/.usb_update/pending.zip)は
    # フォルダごとroot所有で作られるため、フォルダ自体とその中身も対象に含める
    update_staging_dir = os.path.join(image_folder, ".usb_update")
    if os.path.isdir(update_staging_dir):
        targets.append(update_staging_dir)
        try:
            targets += [os.path.join(update_staging_dir, f) for f in os.listdir(update_staging_dir)]
        except OSError:
            pass

    for path in targets:
        if not os.path.exists(path):
            continue
        try:
            shutil.chown(path, user=POPHUG_USER, group=POPHUG_GROUP)
            os.chmod(path, 0o755 if os.path.isdir(path) else 0o644)
        except (LookupError, PermissionError, OSError) as e:
            log(f"所有者の復元に失敗しました（無視して続行）: {path}: {e}")


def detect_fs_type(device_path):
    r = run(["blkid", "-o", "value", "-s", "TYPE", device_path])
    return r.stdout.strip()


def mount_readonly(device_path):
    """指定デバイスを読み取り専用でマウントする。USB側の内容は一切変更しない。
    戻り値: (成功したか, エラーメッセージ or None)"""
    fs_type = detect_fs_type(device_path)
    mount_type = {"vfat": "vfat", "exfat": "exfat"}.get(fs_type)
    if mount_type is None:
        return False, f"未対応のファイルシステムです（{fs_type or '不明'}）。FAT32/exFATのみ対応しています"

    os.makedirs(MOUNT_POINT, exist_ok=True)
    r = run(["mount", "-t", mount_type, "-o", "ro", device_path, MOUNT_POINT], timeout=15)
    if r.returncode != 0:
        return False, (r.stderr or r.stdout or "マウントに失敗しました").strip()
    return True, None


def unmount():
    run(["umount", MOUNT_POINT], timeout=15)


def file_hash(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def looks_like_valid_image(path, ext):
    """拡張子どおりのマジックバイト（ファイル先頭の署名）を持っているか確認する。
    macOSのAppleDouble付随ファイル(._写真.jpg)等、拡張子だけ画像に見えて
    中身が画像ではないファイルを弾くための最終チェック。"""
    signatures = MAGIC_BYTES.get(ext)
    if not signatures:
        return True  # 対象外拡張子は呼び出し元で既に除外されている
    try:
        with open(path, "rb") as f:
            head = f.read(16)
    except OSError:
        return False
    return any(head.startswith(sig) for sig in signatures)


def import_images(source_dir, image_folder, ts=None):
    """マウント済み(または単体テスト用に用意した通常の)ディレクトリsource_dirの
    トップレベルにある画像を、image_folderへ取り込む中核ロジック。

    実際のUSBデバイスのマウント/アンマウント処理とは独立させてあり、
    USB無しでも（source_dirを普通のディレクトリに差し替えれば）検証できる。

    以前に取り込み済み（内容のハッシュ値が一致）の画像が含まれている場合は、
    再コピーはせず「表示」に戻すだけにする。これにより、複数人がそれぞれ
    自分のUSBメモリーを持ち込んで運用する場合でも、USBメモリーを差し替える
    だけで「自分が今まで取り込んだ画像一式」に切り替えることができる
    （USBの中身をコピーし直す必要が無い）。

    戻り値: dict {
        "imported": [...今回新しくコピーしたファイル名...],
        "restored": [...以前取り込み済みで、今回「表示」に戻したファイル名...],
        "pinned": [...新規コピー分のうち固定表示に設定したファイル名...],
        "error": エラーメッセージ or None,
    }
    """
    empty_result = {"imported": [], "restored": [], "pinned": [], "error": None}

    if signage_state is None:
        return {**empty_result, "error": "signage_state.pyが見つかりません（インストール先を確認してください）"}

    os.makedirs(image_folder, exist_ok=True)

    try:
        entries = sorted(os.listdir(source_dir))
    except OSError as e:
        return {**empty_result, "error": f"USBメモリーの読み込みに失敗しました（{e}）"}

    # サブフォルダは対象外。トップレベルの対応拡張子ファイルのみを候補にする。
    # ドットファイル（.で始まる隠しファイル。macOSが自動生成する ._写真.jpg や
    # .DS_Store 等）は、拡張子が一致していても除外する
    candidates = []
    skipped_non_image = 0
    for name in entries:
        if name.startswith("."):
            continue
        full = os.path.join(source_dir, name)
        if not os.path.isfile(full):
            continue
        ext = os.path.splitext(name)[1].lower()
        if ext not in SUPPORTED_EXT:
            continue
        if not looks_like_valid_image(full, ext):
            # 拡張子は画像だが中身が画像ではない（AppleDouble等）。取り込まない
            log(f"{name} は画像として認識できないためスキップします")
            skipped_non_image += 1
            continue
        candidates.append((name, full, ext))

    if not candidates:
        error = ("USBメモリーの直下（一番上の階層）に、取り込める画像が見つかりませんでした。"
                  "サブフォルダの中に置いた画像は読み込めません。USBメモリーの直下に"
                  "直接コピーしてください。"
                  + (f"（{skipped_non_image}件は画像として認識できずスキップしました）"
                     if skipped_non_image else ""))
        return {**empty_result, "error": error}

    imported_hashes = signage_state.load_usb_imported(image_folder)
    hidden = signage_state.load_hidden(image_folder)
    pinned = signage_state.load_pinned(image_folder)

    existing_before = set(
        f for f in os.listdir(image_folder)
        if os.path.splitext(f)[1].lower() in SUPPORTED_EXT
    )

    ts = ts or time.strftime("%Y%m%d_%H%M%S")
    new_filenames = []
    restored_filenames = []
    new_pinned = []
    index = 1

    for name, full, ext in candidates:
        try:
            h = file_hash(full)
        except OSError as e:
            log(f"{name} の読み込みに失敗しました（スキップ）: {e}")
            continue

        prior_name = imported_hashes.get(h)
        if prior_name and os.path.exists(os.path.join(image_folder, prior_name)):
            # 以前に取り込み済みで、実体もまだ残っている＝再コピーせず表示に戻すだけ
            restored_filenames.append(prior_name)
            continue
        # ハッシュ記録はあるが実体が消えている（Web画面で削除された等）場合は、
        # 新規取り込みと同様に扱う（下へフォールスルー）

        is_pinned = name.lower().startswith(FIXED_PREFIX)
        dest_name = f"usb_{ts}_{index:03d}{ext}"
        while os.path.exists(os.path.join(image_folder, dest_name)):
            index += 1
            dest_name = f"usb_{ts}_{index:03d}{ext}"
        index += 1
        dest_path = os.path.join(image_folder, dest_name)

        try:
            shutil.copyfile(full, dest_path)
        except OSError as e:
            log(f"{name} のコピーに失敗しました（スキップ）: {e}")
            continue

        imported_hashes[h] = dest_name
        new_filenames.append(dest_name)
        if is_pinned:
            new_pinned.append(dest_name)
            pinned.add(dest_name)

    batch = set(new_filenames) | set(restored_filenames)
    if not batch:
        return {**empty_result, "error": "取り込める画像がありませんでした"}

    # 今回のUSBの内容（新規コピー分＋表示に戻した分）・固定表示画像 以外の
    # 既存画像を一括で非表示化する（削除はしない＝Web画面のギャラリーには残り、
    # 後で手動で表示に戻せる）
    for f in existing_before:
        if f in batch or f in pinned:
            continue
        hidden.add(f)
    for f in batch:
        hidden.discard(f)

    signage_state.save_hidden(image_folder, hidden)
    signage_state.save_pinned(image_folder, pinned)
    signage_state.save_usb_imported(image_folder, imported_hashes)

    return {
        "imported": new_filenames,
        "restored": restored_filenames,
        "pinned": new_pinned,
        "error": None,
    }


def build_notice_message(result):
    if result["error"] and not (result["imported"] or result["restored"]):
        return result["error"]

    total = len(result["imported"]) + len(result["restored"])
    msg = f"USBから画像を{total}枚表示しました"
    details = []
    if result["imported"]:
        details.append(f"新規{len(result['imported'])}枚")
    if result["restored"]:
        details.append(f"取り込み済みを再表示{len(result['restored'])}枚")
    if result["pinned"]:
        details.append(f"うち固定表示{len(result['pinned'])}枚")
    if details:
        msg += "（" + "・".join(details) + "）"
    msg += "。以前の画像は非表示になりました。USBを取り外してください"
    return msg


# ---------------- USBオフラインアップデートパッケージの検出・ステージング ----------------
# GitHub Releaseの「Source code (zip)」をそのままUSBのルートに置いておくだけで
# 検出できるようにする（ファイル名のリネームは要求しない）。安全のため、
# ここでは検出とローカルへのコピー（ステージング）だけを行い、実際の適用は
# 一切行わない。適用は本体ボタンの長押しでmain.py側が確定した時に、
# update_check.apply_update_from_zip()経由で行われる。

def _inspect_update_zip(path):
    """zipファイルがpophug-signageのアップデートパッケージ（GitHub Releaseの
    source code zipそのもの）らしいかどうかを確認し、バージョン文字列を取り出す。
    それらしくない場合（構成が違う、version.pyが読めない等）はNoneを返す。
    無関係なzipファイルが同じUSBに入っていても、単に無視されるだけで安全。"""
    try:
        with zipfile.ZipFile(path) as zf:
            names = zf.namelist()
            top_dirs = set(n.split("/", 1)[0] for n in names if "/" in n)
            if len(top_dirs) != 1:
                return None
            top = next(iter(top_dirs))
            required = {f"{top}/{fn}" for fn in UPDATE_ZIP_REQUIRED_FILES}
            if not required.issubset(set(names)):
                return None
            with zf.open(f"{top}/version.py") as vf:
                content = vf.read().decode("utf-8", errors="replace")
    except (zipfile.BadZipFile, OSError, KeyError):
        return None

    m = re.search(r'__version__\s*=\s*["\']([\d.]+)["\']', content)
    if not m:
        return None
    return {"version": m.group(1)}


def find_and_stage_update_package(source_dir, image_folder):
    """USBのトップレベルにあるzipファイルの中から、アップデートパッケージらしき
    ものを探す。見つかった場合は images/.usb_update/pending.zip へコピーし、
    images/.usb_update_pending.json に検出結果を書き込む（実際の適用はしない、
    本体ボタンの長押しで確定されるまで待つ）。現在実行中のバージョン以下の
    パッケージは無視する（巻き戻り防止。オンラインOTAと同じ方針）。
    戻り値: 検出・ステージングできた場合はユーザー向けメッセージ、
            何もしなかった場合はNone"""
    if update_check is None:
        return None  # update_check.pyが未配置の環境では機能自体を無効化する

    try:
        entries = sorted(os.listdir(source_dir))
    except OSError:
        return None

    for name in entries:
        if name.startswith(".") or not name.lower().endswith(".zip"):
            continue
        full = os.path.join(source_dir, name)
        if not os.path.isfile(full):
            continue

        info = _inspect_update_zip(full)
        if info is None:
            continue

        current = update_check.__version__
        if update_check._parse_version(info["version"]) <= update_check._parse_version(current):
            log(f"{name}（v{info['version']}）は現在のバージョン（v{current}）以下のため無視します")
            continue

        staging_dir = os.path.join(image_folder, ".usb_update")
        os.makedirs(staging_dir, exist_ok=True)
        staged_zip = os.path.join(staging_dir, "pending.zip")
        try:
            shutil.copyfile(full, staged_zip)
        except OSError as e:
            log(f"アップデートパッケージのコピーに失敗しました（{name}）: {e}")
            continue

        signage_state.save_usb_update_pending(
            image_folder, version=info["version"], zip_path=staged_zip, current_version=current)
        log(f"USBアップデートパッケージを検出・ステージングしました: {name} "
            f"（v{current} → v{info['version']}）。本体ボタンの長押しで適用を確定できます")
        return f"アップデート(v{info['version']})を検出しました。本体ボタンの長押しで適用できます"

    return None


# ---------------- USB設定ファイルの読み込み・自動適用 ----------------
# Web設定画面で変更できる項目（画像切替間隔、トランジション等）を、
# USBメモリー直下に置いた「pophug-settings.txt」というテキストファイルからも
# 設定できるようにする。「key = value」形式で、'#'以降はコメット。
# 画像取り込みと同様、確認なしで即座に自動適用する（設定はコード実行を伴わず、
# いつでもWeb画面から元に戻せる可逆的な操作のため、USBアップデートのような
# ボタン長押し確認は要求しない）。複数台に同じ設定を配って回る運用を想定。

def parse_settings_text_file(path):
    """key = value 形式のテキストファイルを解析する。
    '#'以降はコメントとして無視。空行・コメントのみの行、'='が無い行、
    キーが空の行も無視する。値の妥当性チェックはここでは行わない
    （signage_state.validate_settings_updatesに任せる）。
    戻り値: {key: value(文字列)} の辞書。読み込み自体に失敗した場合は空の辞書。"""
    raw = {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            lines = f.readlines()
    except (OSError, UnicodeDecodeError) as e:
        log(f"設定ファイルの読み込みに失敗しました（{path}）: {e}")
        return raw

    for lineno, line in enumerate(lines, start=1):
        body = line.split("#", 1)[0].strip()
        if not body:
            continue
        if "=" not in body:
            log(f"設定ファイル {lineno}行目: '=' が無いため無視します: {line.rstrip()!r}")
            continue
        key, _, value = body.partition("=")
        key = key.strip()
        value = value.strip()
        if not key:
            continue
        raw[key] = value
    return raw


def _describe_settings_issues(errors, unknown, max_items=5):
    """設定ファイルのうち無視された項目を、画面通知用に人が読める形へ整形する。
    件数だけでなく「どのキーが」「なぜ」無視されたのかがその場で（USBを挿した
    本体の画面だけを見て）分かるようにする。複数店舗をUSBで回る運用では、
    SSHでログを見に行く前提にはできないため。項目が多すぎる場合は主要な
    ものだけ示し、残りは件数でまとめる（通知バナーが際限なく長くならないため）。
    戻り値: 説明文（無視した項目が無ければ空文字列）"""
    parts = []
    shown = 0
    for key, reason in errors:
        if shown >= max_items:
            break
        parts.append(f"{key}（{reason}）")
        shown += 1
    for key in unknown:
        if shown >= max_items:
            break
        parts.append(f"{key}（見覚えのないキーです）")
        shown += 1

    total = len(errors) + len(unknown)
    if not parts:
        return ""
    text = "反映されなかった項目：" + "、".join(parts)
    if total > shown:
        text += f" 他{total - shown}件"
    return text


def find_and_apply_settings_file(source_dir, image_folder):
    """USBのトップレベルにある設定ファイル(pophug-settings.txt、大文字小文字は
    区別しない)を探し、有効な項目だけをimages/.settings.jsonへ即座に自動適用する。
    ファイルの一部の行に誤りがあっても、有効な行だけを適用し、無効な行は
    個別にスキップしてログへ警告を残す（1箇所のタイプミスで全体が反映され
    ないと、手打ちのテキストファイルでは扱いづらいため）。無効だった項目は
    保存されず、その設定は元の値のまま変わらない。
    戻り値のメッセージには、実際に変更した項目（キー=値）と、無視した項目
    （キーと理由）の両方を具体的に含める。本体画面の通知だけを見て
    「何が変わり、何が変わらなかったか（＝直すべき箇所）」が分かるようにする
    ため（SSHでログを見に行く前提にはできない運用のため）。
    戻り値: 適用結果を表すユーザー向けメッセージ、またはファイルが無ければNone。"""
    if signage_state is None:
        return None

    try:
        entries = os.listdir(source_dir)
    except OSError:
        return None

    matches = [n for n in entries if n.lower() == SETTINGS_FILENAME]
    if not matches:
        return None
    name = matches[0]
    path = os.path.join(source_dir, name)
    if not os.path.isfile(path):
        return None

    raw = parse_settings_text_file(path)
    if not raw:
        log(f"設定ファイル（{name}）に有効な設定項目が見つかりませんでした")
        return f"設定ファイル（{name}）に有効な項目が見つかりませんでした"

    valid, errors = signage_state.validate_settings_updates(raw)

    recognized = set(valid) | {key for key, _ in errors}
    unknown = sorted(set(raw) - recognized)
    for key in unknown:
        log(f"設定ファイル（{name}）: 未知のキーを無視します: {key}")
    for key, reason in errors:
        log(f"設定ファイル（{name}）: {key} の値が不正なため無視します（{reason}）: {raw.get(key)!r}")

    issue_desc = _describe_settings_issues(errors, unknown)

    if not valid:
        msg = f"設定ファイル（{name}）に反映できる項目がありませんでした"
        if issue_desc:
            msg += f"。{issue_desc}"
        return msg

    signage_state.save_settings(image_folder, valid)

    applied_desc = "、".join(f"{k}={v}" for k, v in valid.items())
    log(f"設定ファイル（{name}）から{len(valid)}件を適用しました: {applied_desc}")

    msg = f"設定ファイルを適用しました：{applied_desc}"
    if issue_desc:
        msg += f"。{issue_desc}"
    return msg


def parse_arg(arg):
    """systemdのインスタンス名（%i）から (デバイス名, イベント種別) を取り出す。
    例: "sda1-add" -> ("sda1", "add"), "sda1-remove" -> ("sda1", "remove")。
    末尾に-add/-removeが無い場合は後方互換としてadd扱いにする。"""
    if arg.endswith("-remove"):
        return arg[: -len("-remove")], "remove"
    if arg.endswith("-add"):
        return arg[: -len("-add")], "add"
    return arg, "add"


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: pophug-usb-import <device-event e.g. sda1-add / sda1-remove>")

    device_name, event = parse_arg(sys.argv[1])

    if not DEVICE_RE.match(device_name):
        sys.exit(f"invalid device name: {device_name}")

    if signage_state is None:
        sys.exit(f"signage_state.py not found under {REPO_DIR}")

    # 複数のUSBパーティションがほぼ同時に挿抜された場合の競合を避けるため、
    # 状態ファイル(.hidden.json等)を触る一連の処理を直列化する
    lock_fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR)
    fcntl.flock(lock_fd, fcntl.LOCK_EX)
    try:
        if event == "remove":
            handle_removal()
        else:
            handle_add(device_name)
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)


def handle_removal():
    """USBメモリーが取り外された時（udevのremoveイベント）に呼ばれる。
    表示中の「USBを取り外してください」通知（sticky）を消す。
    読み取り専用マウントなので、抜くタイミングによってUSB側が壊れる心配は無い。"""
    signage_state.clear_notice(IMAGE_FOLDER)
    fix_ownership(IMAGE_FOLDER)
    log("USBメモリーの取り外しを検知し、通知を消去しました")


def handle_add(device_name):
    """USBメモリーが挿入された時（udevのaddイベント）に呼ばれる。"""
    device_path = f"/dev/{device_name}"
    if not os.path.exists(device_path):
        sys.exit(f"device not found: {device_path}")

    ok, err = mount_readonly(device_path)
    if not ok:
        log(f"マウント失敗: {err}")
        signage_state.save_notice(IMAGE_FOLDER, f"USBメモリーを読み込めませんでした（{err}）", sticky=True)
        fix_ownership(IMAGE_FOLDER)
        return

    try:
        result = import_images(MOUNT_POINT, IMAGE_FOLDER)
        update_message = find_and_stage_update_package(MOUNT_POINT, IMAGE_FOLDER)
        settings_message = find_and_apply_settings_file(MOUNT_POINT, IMAGE_FOLDER)
    finally:
        unmount()

    # 写真が1枚も無い（＝スライドショー自体には見た目の変化が起きない）USBの場合、
    # 「完全に空」「アップデートパッケージのみ」「設定ファイルのみ」「それらの
    # 組み合わせ」のどのケースでも、その場にいる人が確認できる情報は画面の通知
    # だけになる。理由が何であれ、写真が見つからなかった場合は同じ重みで
    # フルスクリーン表示にする（アップデート検出だけ小さなバナーのままだと、
    # 「本体ボタンの長押しで適用できます」という重要な案内が見落とされかねないため）。
    # 逆に写真が見つかった場合は、スライドショーの変化自体が「成功した」ことを
    # 物語るので、画面を専有するほどではない控えめなバナーのままにする。
    have_images = bool(result["imported"] or result["restored"])

    if have_images:
        parts = [build_notice_message(result)]
        if update_message:
            parts.append(update_message)
        if settings_message:
            parts.append(settings_message)
        message = "　".join(parts)
        signage_state.save_notice(IMAGE_FOLDER, message, sticky=True)
    else:
        parts = []
        if update_message:
            parts.append(update_message)
        if settings_message:
            parts.append(settings_message)
        if parts:
            message = "　".join(parts)
        else:
            # 画像・アップデートパッケージ・設定ファイルのいずれも見つからなかった
            # （USBが空・非対応形式のみ・トップレベルではなくサブフォルダの中に
            # 置いてしまっている、等）。result["error"]には状況に応じた具体的な
            # 理由（読み込み失敗の詳細等）が入っていることもあるため、それが
            # あれば優先して使う。
            message = result["error"] or (
                "USBメモリーの直下に画像ファイルがありません。"
                "画像・アップデートパッケージ・設定ファイルは、"
                "USBメモリーの一番上の階層（フォルダの外）に直接置いてください。"
            )
        signage_state.save_notice(IMAGE_FOLDER, message, sticky=True, fullscreen=True)

    fix_ownership(IMAGE_FOLDER)
    log(message)


if __name__ == "__main__":
    main()

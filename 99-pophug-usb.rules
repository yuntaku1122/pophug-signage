# ============================================
# pophug: USBメモリー挿入時の画像自動取り込み
#
# USB接続のブロックデバイス（パーティション）が追加された時だけ、
# pophug-usb-import@<デバイス名>.service を起動する。
#
#   KERNEL=="sd[a-z][0-9]"  … パーティションのみに限定（ディスク全体 sda 等は除外）
#   ENV{ID_BUS}=="usb"      … USB接続のものだけに限定
#                              （SDカード本体はmmcblk0側の名前空間なので元々対象外）
#
# インストール:
#   sudo cp 99-pophug-usb.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
# ============================================
SUBSYSTEM=="block", KERNEL=="sd[a-z][0-9]", ACTION=="add", ENV{ID_BUS}=="usb", TAG+="systemd", ENV{SYSTEMD_WANTS}+="pophug-usb-import@%k.service"

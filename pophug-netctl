#!/usr/bin/env python3
# ============================================
# pophug-netctl
#
# KitchenCar POP Signageの「Wi-Fiセットアップモード」用の、
# root権限が必要なネットワーク操作だけを行う限定ヘルパースクリプト。
#
# アプリ本体(pophugユーザー)はこのスクリプトだけをsudo経由で呼び出す。
# nmcliを直接野放しにするのではなく、ここで扱えるコマンドと
# 引数の形式を厳しく制限することで、必要最小限の権限だけを与える。
#
# 使い方:
#   pophug-netctl hotspot-start <ssid> <password>
#   pophug-netctl hotspot-stop
#   pophug-netctl scan
#   pophug-netctl connect <ssid> <password>
#   pophug-netctl retry-known
#
# インストール:
#   sudo cp pophug-netctl /usr/local/bin/
#   sudo chmod 755 /usr/local/bin/pophug-netctl
#   sudo chown root:root /usr/local/bin/pophug-netctl
# ============================================

import os
import subprocess
import sys
import time

HOTSPOT_CON_NAME = "pophug-setup-ap"

# retry-known実行中であることを示す目印ファイル。
# Pi Zero 2Wは無線が1系統しか無く、この処理中はセットアップ用アクセスポイントを
# 一時的に落とすため、main.py側がその一瞬を「アクセスポイントが終了した
# （=スタンドアロンモード終了）」と誤検知しないよう、存在チェック用に置いておく
# （wifi_setup.py側はroot権限が無いのでread-onlyで存在確認するだけ）。
RETRY_MARKER_PATH = "/tmp/pophug-wifi-retry-in-progress"


def run(cmd, timeout=30):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        class _R:
            returncode = 1
            stdout = ""
            stderr = "timeout"
        return _R()


def valid_ssid(ssid):
    """SSIDとして許容できるかを検証する。

    以前は使える文字を [\\w\\-\\. ]（英数字・アンダースコア・ハイフン・ドット・
    スペースのみ）に厳しく制限していたが、これだとiPhoneの個人ホットスポットの
    デフォルト名（例: "Satoru's iPhone"）のようなアポストロフィを含む、ごく普通の
    SSIDまで「invalid ssid」として弾いてしまう不具合があった（実機で発生）。

    nmcliへは配列引数としてそのまま渡しており（shell=Trueではない）、シェル経由の
    コマンドインジェクションのリスクはそもそも無い。ここで防ぐべきなのは以下だけ:
      - 空文字（SSIDとして意味を成さない）
      - Wi-Fi規格上のSSID長の上限（32バイト、UTF-8換算。絵文字や日本語のSSIDは
        1文字が複数バイトになるため、文字数ではなくバイト数で判定する）
      - 制御文字（NUL・改行など。ログや設定ファイルへの書き込みで問題を起こしうる）
      - 先頭が "-" のもの（nmcli自身が値ではなくオプションフラグと誤解する可能性がある）
    """
    if not ssid:
        return False
    if ssid.startswith("-"):
        return False
    if len(ssid.encode("utf-8", errors="surrogatepass")) > 32:
        return False
    if any(ord(c) < 0x20 or ord(c) == 0x7f for c in ssid):
        return False
    return True


def valid_password(password):
    # 空文字(オープンネットワーク)か、WPA2の規格上の範囲(8〜63文字)
    return password == "" or 8 <= len(password) <= 63


def cmd_hotspot_start(args):
    if len(args) != 2:
        sys.exit("usage: hotspot-start <ssid> <password>")
    ssid, password = args
    if not valid_ssid(ssid):
        sys.exit("invalid ssid")
    if not valid_password(password):
        sys.exit("invalid password")

    # 既存の同名プロファイルが残っていれば作り直す
    run(["nmcli", "connection", "delete", HOTSPOT_CON_NAME])

    add_cmd = [
        "nmcli", "connection", "add", "type", "wifi", "ifname", "wlan0",
        "con-name", HOTSPOT_CON_NAME, "autoconnect", "no", "ssid", ssid,
        "802-11-wireless.mode", "ap", "802-11-wireless.band", "bg",
        "ipv4.method", "shared",
    ]
    if password:
        add_cmd += ["wifi-sec.key-mgmt", "wpa-psk", "wifi-sec.psk", password]

    r = run(add_cmd)
    if r.returncode != 0:
        sys.exit(f"failed to create hotspot profile: {r.stderr}")

    r = run(["nmcli", "connection", "up", HOTSPOT_CON_NAME])
    if r.returncode != 0:
        sys.exit(f"failed to activate hotspot: {r.stderr}")

    print("hotspot started")


def cmd_hotspot_stop(args):
    run(["nmcli", "connection", "down", HOTSPOT_CON_NAME])
    run(["nmcli", "connection", "delete", HOTSPOT_CON_NAME])
    print("hotspot stopped")


def cmd_scan(args):
    run(["nmcli", "device", "wifi", "rescan"])
    r = run(["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "device", "wifi", "list"], timeout=20)
    print(r.stdout)


def _delete_connections_for_ssid(ssid):
    """指定SSIDに紐づく既存の接続プロファイルを探して削除する。
    netplanなど別の仕組みで作られた不完全なプロファイルが残っていると、
    'nmcli device wifi connect' がそれを使い回そうとして
    '802-11-wireless-security.key-mgmt: property is missing' のような
    エラーで失敗することがあるため、毎回まっさらな状態から接続し直す。"""
    r = run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"])
    for line in r.stdout.splitlines():
        parts = line.split(":")
        if len(parts) < 2 or parts[1] != "802-11-wireless":
            continue
        name = parts[0]
        if name == HOTSPOT_CON_NAME:
            continue
        ssid_check = run(["nmcli", "-g", "802-11-wireless.ssid", "connection", "show", name])
        if ssid_check.stdout.strip() == ssid:
            run(["nmcli", "connection", "delete", name])


def _has_real_ip(device="wlan0"):
    """指定デバイスに実際にIPv4アドレスが割り当てられているかを確認する。

    nmcliが「接続成功(returncode 0)」と報告しても、実際にはDHCPでの
    アドレス取得が失敗している/リンクローカルアドレスしか持てていない、
    というケースがPi Zero 2Wの無線チップ(brcmfmac)で確認されているため、
    接続成功の最終判定はnmcliの戻り値だけでなくこちらで行う。"""
    r = run(["nmcli", "-g", "IP4.ADDRESS", "device", "show", device])
    addr = r.stdout.strip().splitlines()[0] if r.stdout.strip() else ""
    ip = addr.split("/")[0] if addr else ""
    return bool(ip) and not ip.startswith("169.254.")  # リンクローカルは未接続扱い


def cmd_connect(args):
    if len(args) != 2:
        sys.exit("usage: connect <ssid> <password>")
    ssid, password = args
    if not valid_ssid(ssid):
        sys.exit("invalid ssid")
    if not valid_password(password):
        sys.exit("invalid password")

    # Pi Zero 2Wは無線が1系統しか無いため、セットアップ用アクセスポイントと
    # 通常の子機接続を同時には維持できない。接続を試す前に一旦落とす。
    run(["nmcli", "connection", "down", HOTSPOT_CON_NAME])

    def try_connect(hidden):
        _delete_connections_for_ssid(ssid)
        cmd = ["nmcli", "device", "wifi", "connect", ssid]
        if hidden:
            # 一覧に出てこない非表示（ステルス）ネットワーク向け。nmcliに積極的な
            # プローブ接続を指示する。逆に、通常の(ビーコンを出している)ネットワーク
            # に対してこれを常用すると、Pi Zero 2Wの無線チップ(brcmfmac)との相性で
            # 接続が不安定になるケースが確認されているため、通常接続が
            # 「SSIDが見つからない」で失敗した場合の再試行としてのみ使う。
            cmd += ["hidden", "yes"]
        if password:
            cmd += ["password", password]
        r = run(cmd, timeout=25)
        if r.returncode != 0:
            return r

        # nmcliが成功と報告した直後は、DHCPでのアドレス取得がまだ完了して
        # いないことがあるため、少し待ちながら実際のIP取得を確認する
        for _ in range(4):
            if _has_real_ip():
                return r
            time.sleep(1.5)

        r.returncode = 1
        r.stderr = (r.stderr or "") + "\n(接続はできましたが、IPアドレスを取得できませんでした)"
        return r

    r = try_connect(hidden=False)
    if r.returncode != 0:
        err_text = (r.stderr or r.stdout or "").lower()
        if "no network with ssid" in err_text:
            # 通常のスキャンでは見つからなかった。非表示ネットワークの可能性が
            # あるので、積極的なプローブ接続で自動的に再試行する
            r = try_connect(hidden=True)
        else:
            # SSIDは見つかったがIP取得等で失敗した場合は、無線チップの一時的な
            # 不調である可能性があるため、もう一度だけ同じ条件で再試行する
            r = try_connect(hidden=False)

    if r.returncode != 0:
        # 失敗したらセットアップ用アクセスポイントに戻し、再試行できるようにする
        run(["nmcli", "connection", "up", HOTSPOT_CON_NAME])
        sys.exit(f"connect failed: {r.stderr or r.stdout}")

    run(["nmcli", "connection", "delete", HOTSPOT_CON_NAME])
    print("connected")


def _active_wireless_connections():
    """現在アクティブな802-11-wireless接続の(名前, タイプ)一覧を返す"""
    r = run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"])
    result = []
    for line in r.stdout.splitlines():
        parts = line.split(":")
        if len(parts) >= 2 and parts[1] == "802-11-wireless":
            result.append(parts[0])
    return result


def cmd_retry_known(args):
    """過去に接続したことがある(=保存済みプロファイルが残っている)Wi-Fiへの
    再接続をNetworkManagerに任せて試みる。SSID・パスワードの再入力は不要。

    Pi Zero 2Wは無線が1系統しか無いため、セットアップ用アクセスポイントが
    起動中はスキャン・接続ができない。一旦落として試し、既知のネットワークが
    見つからず失敗した場合は同じアクセスポイントに戻す。"""
    hotspot_was_active = HOTSPOT_CON_NAME in _active_wireless_connections()

    try:
        with open(RETRY_MARKER_PATH, "w", encoding="utf-8") as f:
            f.write("1")
    except OSError as e:
        print(f"目印ファイルの作成に失敗しました（無視して続行）: {e}")

    try:
        if hotspot_was_active:
            run(["nmcli", "connection", "down", HOTSPOT_CON_NAME])

        # 「wlan0にとって今一番良い、既知の接続を試す」というnmcli標準のコマンド。
        # 新規にプロファイルを作らず、保存済みのものだけを対象にする。
        r = run(["nmcli", "device", "connect", "wlan0"], timeout=30)

        connected_to_known = any(
            name != HOTSPOT_CON_NAME for name in _active_wireless_connections()
        )

        if r.returncode != 0 or not connected_to_known:
            if hotspot_was_active:
                run(["nmcli", "connection", "up", HOTSPOT_CON_NAME])
            reason = (r.stderr or r.stdout or "").strip() or "近くに既知のWi-Fiが見つかりませんでした"
            sys.exit(f"retry failed: {reason}")

        print("connected")
    finally:
        try:
            os.remove(RETRY_MARKER_PATH)
        except OSError:
            pass


COMMANDS = {
    "hotspot-start": cmd_hotspot_start,
    "hotspot-stop": cmd_hotspot_stop,
    "scan": cmd_scan,
    "connect": cmd_connect,
    "retry-known": cmd_retry_known,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        sys.exit(f"usage: pophug-netctl <{'|'.join(COMMANDS)}> [args...]")
    COMMANDS[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
